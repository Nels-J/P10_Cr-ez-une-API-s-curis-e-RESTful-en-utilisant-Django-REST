// https://www.jetbrains.com/help/idea/http-client-in-product-code-editor.html
// Variables en provenance soit de http-client.env.json, soit de http-client.private.env

### Login
POST {{host}}/support_app/auth/token/
Content-Type: application/json

{
  "username": "{{username}}",
  "password": "{{password}}"
}

> {%
    // Stockage des tokens dans les variables globales pour les utiliser dans les requêtes suivantes
    client.global.set("access_token", response.body.access);
    client.global.set("refresh_token", response.body.refresh);
%}

### User list reachable with authentication
GET {{host}}/users/
Authorization: Bearer {{access_token}}

> {%
    client.log("Accès à l'endpoint /users/ OK si le token fourni est valide.");
    client.log("Liste des utilisateurs : " + JSON.stringify(response.body, null, 2));
%}

### Create a new user
POST {{host}}/users/
Content-Type: application/json

{
  "username": "newuserAPI2",
  "password": "secondapipassword",
  "birth_date": "1977-01-01"
}
